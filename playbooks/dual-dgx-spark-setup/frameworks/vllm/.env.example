# DGX Spark Configuration for vLLM
# Copy this file to playbooks/dual-dgx-spark-setup/.env and edit

# =============================================================================
# DGX Spark Hosts
# =============================================================================
SPARK1_HOST=spark1.local        # Head node hostname (mDNS or IP)
SPARK2_HOST=spark2.local        # Worker node hostname
SPARK_USER=your-username        # SSH username

# =============================================================================
# RDMA Network
# =============================================================================
SPARK1_RDMA_IP=192.168.200.3    # Head node RDMA interface IP
SPARK2_RDMA_IP=192.168.200.13   # Worker node RDMA interface IP
RDMA_INTERFACE=enp1s0f1np1      # RDMA network interface name

# =============================================================================
# Container Settings
# =============================================================================
VLLM_CONTAINER=nvcr.io/nvidia/vllm:26.03-py3
CONTAINER_NAME=vllm-spark

# =============================================================================
# vLLM Defaults
# =============================================================================
DEFAULT_GPU_MEM=0.7             # GPU memory utilization (0.0-1.0)
DEFAULT_MAX_MODEL_LEN=32768     # Maximum context length

# =============================================================================
# Benchmark Defaults
# =============================================================================
BENCH_INPUT_LEN=2048            # Input prompt length for benchmarks
BENCH_OUTPUT_LEN=2000           # Output length for benchmarks
BENCH_NUM_PROMPTS=50            # Number of prompts per benchmark
BENCH_REQUEST_RATE=10           # Requests per second
